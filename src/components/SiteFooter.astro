---
import { footerNavigation, siteConfig } from "@/config/site";

const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner flex flex-col items-center gap-2 py-5 text-center md:items-start md:text-left">
    <a href="/" class="wordmark inline-flex items-center gap-2.5" aria-label={siteConfig.name}>
        <img src="/favicon.svg" alt={siteConfig.name} class="h-7 w-7" />
      <span>Paolo Ragudo</span>
    </a>
    <p class="m-0 text-xs text-muted-foreground">&copy; {currentYear} All rights reserved.</p>
  </div>
</footer>

<style>
  .social-btn {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full);
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .social-btn:hover,
  .social-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-dot {
    width: 2px;
    height: 2px;
    background: var(--border-strong);
    border-radius: 50%;
  }
</style>
