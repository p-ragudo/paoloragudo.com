---
interface Props {
  text?: string;
  as?: "p" | "span" | "div";
  class?: string;
}

const { text, as: Component = "p", class: className = "" } = Astro.props;
---

<Component class:list={["monograph-subtitle", className]}>
  {text ? text : <slot />}
</Component>

<style>
  .monograph-subtitle {
    margin: 1.5rem 0 0;
    max-width: 46rem;
    font-family: inherit;
    font-size: clamp(1.125rem, 2.4vw, 1.45rem);
    line-height: 1.42;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--foreground) 88%, transparent);
    text-wrap: pretty;
  }
</style>