---
import Title from "@/components/Title.astro";
import Subtitle from "@/components/Subtitle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
---

<BaseLayout>
  <SiteHeader posts={[]} />

  <main id="content" class="coming-soon-wrapper">
    <div class="coming-soon-inner">
      <Title text="Coming soon" />
      <Subtitle text="Currently building something new. Check back shortly." />
    </div>
  </main>
</BaseLayout>

<style>
  .coming-soon-wrapper {
    /* Pushes content 24% down the entire screen height regardless of screen size */
    padding-top: 24vh;
    padding-bottom: 8rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .coming-soon-inner {
    max-width: 38rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  :global(.coming-soon-inner .monograph-title),
  :global(.coming-soon-inner .monograph-subtitle) {
    text-align: center !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
</style>