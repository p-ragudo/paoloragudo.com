---
import Title from "@/components/Title.astro";
import Subtitle from "@/components/Subtitle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
---

<BaseLayout>
  <SiteHeader posts={[]} />

  <main id="content" class="outer coming-soon-wrapper">
    <div class="coming-soon-inner">
      <Title text="Coming soon" />
      <Subtitle class="mt-4" text="Currently writing the content for this page. Check back shortly." />
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .coming-soon-wrapper {
    /* Fills the screen minus header and footer heights so the footer sits at the very bottom */
    min-height: calc(100vh - 220px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .coming-soon-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>