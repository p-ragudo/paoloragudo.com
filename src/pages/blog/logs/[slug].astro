---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import LocalIcon from "@/components/LocalIcon.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { formatDate, visiblePosts } from "@/lib/posts";
import { logHref, logSlug, sortedLogs, type Log } from "@/lib/logs";

export async function getStaticPaths() {
  const logs = sortedLogs(await getCollection("logs"));
  const allPosts = visiblePosts(await getCollection("posts"));

  return logs.map((log) => ({
    params: { slug: logSlug(log) },
    props: { log, allPosts },
  }));
}

interface Props {
  log: Log;
  allPosts: Awaited<ReturnType<typeof getCollection<"posts">>>;
}

const { log, allPosts } = Astro.props;
const { Content } = await render(log);
const { title, excerpt, date, author, cover } = log.data;
const articleUrl = new URL(logHref(log), siteConfig.siteUrl).toString();
const socialImage = cover
  ? new URL(cover.src.src, siteConfig.siteUrl).toString()
  : new URL(siteConfig.socialImage, siteConfig.siteUrl).toString();
const encodedUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(title);
const shareLinks: { label: string; icon: "twitter-x" | "facebook" | "linkedin"; href: string }[] = [
  {
    label: "X",
    icon: "twitter-x",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    label: "Facebook",
    icon: "facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    label: "LinkedIn",
    icon: "linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: excerpt,
  image: socialImage,
  datePublished: date.toISOString(),
  author: { "@type": "Person", name: author.name },
  publisher: { "@type": "Organization", name: siteConfig.authorName },
  mainEntityOfPage: articleUrl,
};
---

<BaseLayout
  title={title}
  description={excerpt ?? title}
  image={socialImage}
  type="article"
  structuredData={structuredData}
>
  <div class="logs-layout">
    <SiteHeader posts={allPosts} />
    <main id="content" class="outer logs-page">
      <article>
        <header class="canvas pt-10 md:pt-14">
          <a href="/blog/logs/" class="nav-link link-nudge mb-5 inline-flex items-center gap-1">
            <span class="link-nudge__arrow link-nudge__arrow--prev" aria-hidden="true">&larr;</span> Study logs
          </a>
          <p class="meta post-meta">
            <span class="post-meta__byline">By {author.name}</span>
            <span class="post-meta__dates">
              <span class="meta-accent"><time datetime={date.toISOString()}>{formatDate(date, "long")}</time></span>
            </span>
          </p>
          <h1 class="article-title">{title}</h1>
          {excerpt && <p class="article-excerpt">{excerpt}</p>}

          <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-border pt-6" role="group" aria-labelledby="share-heading">
            <h2 id="share-heading" class="eyebrow mr-1">Share</h2>
            {shareLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="share-btn"
                aria-label={`Share ${title} on ${link.label}`}
              >
                <LocalIcon name={link.icon} className="h-4 w-4" />
              </a>
            ))}
            <button
              type="button"
              class="share-btn"
              data-copy-link
              data-copy-url={articleUrl}
              aria-label={`Copy link to ${title}`}
            >
              <LocalIcon name="link-45deg" className="h-4 w-4" />
            </button>
            <p class="ml-1 text-xs text-muted-foreground" aria-live="polite" data-copy-status></p>
          </div>
        </header>

        {cover && (
          <figure class="article-image inner">
            <Image
              src={cover.src}
              alt={cover.alt}
              widths={[640, 960, 1200, 1600, 2000]}
              sizes="(min-width: 1200px) 1200px, 100vw"
              loading="eager"
              decoding="async"
              class="w-full"
            />
            {cover.creditName && (
              <figcaption>
                {cover.creditUrl ? (
                  <a href={cover.creditUrl} rel="noreferrer" class="underline underline-offset-2">
                    {cover.creditName}
                  </a>
                ) : (
                  cover.creditName
                )}
              </figcaption>
            )}
          </figure>
        )}

        <div class="prose canvas mt-12">
          <Content />
        </div>
      </article>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll("[data-copy-link]").forEach((button) => {
    const status = button.parentElement?.querySelector("[data-copy-status]");

    button.addEventListener("click", async () => {
      const url = button.getAttribute("data-copy-url");
      if (!url) return;

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = "Link copied";
      } catch {
        if (status) status.textContent = "Copy failed";
      }
    });
  });
</script>

<style>
  .logs-layout {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .logs-page {
    flex: 1;
  }
</style>