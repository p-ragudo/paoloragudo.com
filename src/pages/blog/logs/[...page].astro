---
import { getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/posts";
import { logHref, sortedLogs, type Log } from "@/lib/logs";

export const getStaticPaths = (async ({ paginate }) => {
  const logs = sortedLogs(await getCollection("logs"));
  return paginate(logs, { pageSize: 15 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Log>;
}

const { page } = Astro.props;
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const title = page.currentPage === 1 ? "Study logs" : `Study logs - Page ${page.currentPage}`;
const withTrailingSlash = (url: string | undefined) => (url && !url.endsWith("/") ? `${url}/` : url);
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<BaseLayout
  title={title}
  description="Study logs and notes from Paolo Ragudo."
  prevUrl={prevUrl}
  nextUrl={nextUrl}
>
  <div class="logs-layout">
    <SiteHeader posts={allPosts} />
    <main id="content" class="outer logs-page">
      <div class="canvas">
        <header class="pagehead">
          <nav aria-label="Breadcrumb" class="mb-2">
            <ol class="flex items-center gap-2 text-xs font-medium uppercase text-muted-foreground">
              <li><a href="/blog/" class="nav-link link-quiet">Blog</a></li>
            </ol>
          </nav>
          <h1 class="pagehead-title mt-1">Study logs</h1>
          <p class="pagehead-description">Notes on what I’m learning and working through.</p>
        </header>

        {page.data.length > 0 ? (
          <ul class="logs-list">
            {page.data.map((log) => (
              <li class="logs-list-item">
                <a href={logHref(log)} class="logs-list-link">
                  <p class="meta logs-list-meta">
                    <time class="meta-accent" datetime={log.data.date.toISOString()}>{formatDate(log.data.date)}</time>
                  </p>
                  <h2 class="logs-list-title">{log.data.title}</h2>
                </a>
                {log.data.excerpt && <p class="logs-list-excerpt">{log.data.excerpt}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground">Study logs are coming soon.</p>
        )}

        {page.total > 0 && (
          <nav class="logs-pagination" aria-label="Study log pagination">
            {prevUrl ? (
              <a href={prevUrl} class="logs-pagination-control" aria-label="Previous page">&lt;</a>
            ) : (
              <span class="logs-pagination-control" aria-disabled="true">&lt;</span>
            )}
            <span class="logs-pagination-current" aria-current="page">{page.currentPage} / {page.lastPage}</span>
            {nextUrl ? (
              <a href={nextUrl} class="logs-pagination-control" aria-label="Next page">&gt;</a>
            ) : (
              <span class="logs-pagination-control" aria-disabled="true">&gt;</span>
            )}
          </nav>
        )}
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .logs-layout {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .logs-page {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .logs-page > .canvas {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  :global(.logs-layout > footer) {
    margin-top: 1rem;
  }

  .logs-list {
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
  }

  .logs-list-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .logs-list-item:first-child {
    padding-top: 0;
  }

  .logs-list-link {
    display: block;
    text-decoration: none;
  }

  .logs-list-meta {
    margin: 0;
  }

  .logs-list-link:hover .logs-list-title,
  .logs-list-link:focus-visible .logs-list-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .logs-list-title {
    margin: 0.35rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .logs-list-excerpt {
    max-width: 42rem;
    margin: 0.35rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .logs-pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: auto 0 1rem;
  }

  .logs-pagination-control,
  .logs-pagination-current {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    color: var(--foreground);
    font-size: 0.875rem;
  }

  .logs-pagination-control {
    text-decoration: none;
  }

  .logs-pagination-control:hover,
  .logs-pagination-control:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .logs-pagination-control[aria-disabled="true"] {
    color: var(--muted-foreground);
    opacity: 0.45;
  }

  .logs-pagination-current {
    width: auto;
    min-width: 4rem;
    padding: 0 0.5rem;
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 600;
  }
</style>