---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/posts";
import { logHref, sortedLogs } from "@/lib/logs";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const logs = sortedLogs(await getCollection("logs"));
---

<BaseLayout title="Study logs" description="Study logs and notes from Paolo Ragudo.">
  <div class="logs-layout">
    <SiteHeader posts={allPosts} />
    <main id="content" class="outer logs-page">
      <div class="canvas">
        <header class="pagehead">
          <a href="/blog/" class="nav-link link-nudge mb-2 inline-flex items-center gap-1">
            <span class="link-nudge__arrow link-nudge__arrow--prev" aria-hidden="true">&larr;</span> Blog
          </a>
          <h1 class="pagehead-title mt-1">Study logs</h1>
          <p class="pagehead-description">Notes on what I’m learning and working through.</p>
        </header>

        {logs.length > 0 ? (
          <ul class="logs-list">
            {logs.map((log) => (
              <li class="logs-list-item">
                <a href={logHref(log)} class="logs-list-link">
                  <p class="meta logs-list-meta">
                    <time class="meta-accent" datetime={log.data.date.toISOString()}>{formatDate(log.data.date)}</time>
                  </p>
                  <h2 class="logs-list-title">{log.data.title}</h2>
                </a>
                {log.data.excerpt && <p class="logs-list-excerpt">{log.data.excerpt}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground">Study logs are coming soon.</p>
        )}
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .logs-layout {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
  }

  .logs-page {
    flex: 1;
  }

  .logs-list {
    margin: 0 0 5rem;
    padding: 0;
    list-style: none;
  }

  .logs-list-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .logs-list-item:first-child {
    padding-top: 0;
  }

  .logs-list-link {
    display: block;
    text-decoration: none;
  }

  .logs-list-meta {
    margin: 0;
  }

  .logs-list-link:hover .logs-list-title,
  .logs-list-link:focus-visible .logs-list-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .logs-list-title {
    margin: 0.35rem 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .logs-list-excerpt {
    max-width: 42rem;
    margin: 0.35rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>