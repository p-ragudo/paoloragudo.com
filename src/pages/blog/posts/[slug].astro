---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import LocalIcon from "@/components/LocalIcon.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Callout from "@/components/mdx/Callout.astro";
import CodeGroup from "@/components/mdx/CodeGroup.astro";
import CodeGroupItem from "@/components/mdx/CodeGroupItem.astro";
import { siteConfig } from "@/config/site";
import {
  authorSlug,
  categoryHref,
  formatDate,
  getAdjacent,
  getRelated,
  postHref,
  postSlug,
  readingLabel,
  visiblePosts,
  type Post,
} from "@/lib/posts";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));
  return allPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allPosts },
  }));
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tableOfContents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasTableOfContents = tableOfContents.length > 0;
const mdxComponents = { Callout, CodeGroup, CodeGroupItem };
const data = post.data;
const related = getRelated(allPosts, post);
const { newer, older } = getAdjacent(allPosts, post);
const authorHref = `/author/${authorSlug(data.author.name)}/`;
const articleUrl = new URL(postHref(post), siteConfig.siteUrl).toString();
const socialImage = data.cover
  ? new URL(data.cover.src.src, siteConfig.siteUrl).toString()
  : new URL(siteConfig.socialImage, siteConfig.siteUrl).toString();
const encodedUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(data.title);
const shareLinks: { label: string; icon: "twitter-x" | "facebook" | "linkedin"; href: string }[] = [
  {
    label: "X",
    icon: "twitter-x",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
  },
  {
    label: "Facebook",
    icon: "facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
  },
  {
    label: "LinkedIn",
    icon: "linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
  },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: data.title,
  description: data.excerpt,
  image: socialImage,
  datePublished: data.date.toISOString(),
  dateModified: (data.updatedDate ?? data.date).toISOString(),
  author: { "@type": "Person", name: data.author.name },
  publisher: { "@type": "Organization", name: siteConfig.authorName },
  mainEntityOfPage: articleUrl,
};
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  image={socialImage}
  type="article"
  structuredData={structuredData}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <article class:list={tableOfContents.length > 0 ? ["article-has-toc"] : []}>
      <header class="article-header canvas pt-10 md:pt-14">
        <nav aria-label="Breadcrumb" class="mb-5">
          <ol class="flex items-center gap-2 text-xs font-medium uppercase text-muted-foreground">
            <li><a href="/blog/" class="nav-link link-quiet">Blog</a></li>
          </ol>
        </nav>
        <p class="meta post-meta">
          <span class="post-meta__byline">
            By <a href={authorHref} class="link-sweep post-meta__link">{data.author.name}</a> in{" "}
            <a href={categoryHref(data.category)} class="link-sweep post-meta__link">{data.category}</a>
          </span>
          <span class="post-meta__dates">
            <span class="meta-accent"><time datetime={data.date.toISOString()}>{formatDate(data.date, "long")}</time></span>
            <span>{readingLabel(post)}</span>
          </span>
        </p>

        <h1 class="article-title">{data.title}</h1>
        <p class="article-excerpt">{data.excerpt}</p>

        {data.updatedDate && (
          <p class="meta mt-5">
            <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>
          </p>
        )}

        <div class="mt-8 flex flex-wrap items-center gap-2 border-t border-border pt-6" role="group" aria-labelledby="share-heading">
          <h2 id="share-heading" class="eyebrow mr-1">Share</h2>
          {shareLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="share-btn"
              aria-label={`Share ${data.title} on ${link.label}`}
            >
              <LocalIcon name={link.icon} className="h-4 w-4" />
            </a>
          ))}
          <button
            type="button"
            class="share-btn"
            data-copy-link
            data-copy-url={articleUrl}
            aria-label={`Copy link to ${data.title}`}
          >
            <LocalIcon name="link-45deg" className="h-4 w-4" />
          </button>
          <p class="ml-1 text-xs text-muted-foreground" aria-live="polite" data-copy-status></p>
        </div>
      </header>

      {data.cover && (
        <figure class="article-image inner">
          <Image
            src={data.cover.src}
            alt={data.cover.alt}
            widths={[640, 960, 1200, 1600, 2000]}
            sizes="(min-width: 1200px) 1200px, 100vw"
            loading="eager"
            decoding="async"
            class="w-full"
          />
          {data.cover.creditName && (
            <figcaption>
              {data.cover.creditUrl ? (
                <a href={data.cover.creditUrl} rel="noreferrer" class="underline underline-offset-2">
                  {data.cover.creditName}
                </a>
              ) : (
                data.cover.creditName
              )}
            </figcaption>
          )}
        </figure>
      )}

      <div class:list={["article-reading-layout inner", tableOfContents.length > 0 && "article-reading-layout--with-toc"]}>
        <div class:list={["article-content-layout", tableOfContents.length > 0 && "article-content-layout--with-toc"]}>
          {tableOfContents.length > 0 && (
            <nav class="article-toc" aria-labelledby="article-toc-heading">
              <h2 id="article-toc-heading" class="eyebrow">On this page</h2>
              <ol>
                {tableOfContents.map((heading, index) => (
                  <li class:list={heading.depth === 3 ? ["article-toc-item--nested"] : []}>
                    <a
                      href={`#${heading.slug}`}
                      data-toc-link
                      aria-current={index === 0 ? "location" : undefined}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <div class="prose canvas article-body mt-12">
            <Content components={mdxComponents} />
          </div>
        </div>

        {(newer || older) && (
          <footer class="canvas article-navigation mt-16 border-t border-border pt-8">
            <nav class="grid gap-8 sm:grid-cols-2" aria-label="Post navigation">
              <div>
                {older && (
                  <a href={postHref(older)} class="link-title link-nudge">
                    <span class="eyebrow">
                      <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> Previous
                    </span>
                    <span class="link-title__text mt-2 block font-semibold leading-snug">{older.data.title}</span>
                  </a>
                )}
              </div>
              <div class="sm:text-right">
                {newer && (
                  <a href={postHref(newer)} class="link-title link-nudge">
                    <span class="eyebrow">
                      Next <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
                    </span>
                    <span class="link-title__text mt-2 block font-semibold leading-snug">{newer.data.title}</span>
                  </a>
                )}
              </div>
            </nav>
          </footer>
        )}
      </div>
    </article>

    {related.length > 0 && (
      <section class="canvas article-related mt-[var(--space-section)]" aria-labelledby="keep-reading">
        <h2 id="keep-reading" class="section-title">Keep reading</h2>
        <div class="grid gap-7">
          {related.map((item) => <PostCard post={item} variant="compact" headingLevel="h3" />)}
        </div>
      </section>
    )}
  </main>
  <SiteFooter />

  <script is:inline>
    document.querySelectorAll("[data-copy-link]").forEach((button) => {
      const status = button.parentElement?.querySelector("[data-copy-status]");

      button.addEventListener("click", async () => {
        const url = button.getAttribute("data-copy-url");
        if (!url) return;

        try {
          if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
          await navigator.clipboard.writeText(url);
          if (status) status.textContent = "Link copied";
        } catch {
          if (status) status.textContent = "Copy failed";
        }
      });
    });

    /* Progressive enhancement: every code block in the article body gets a copy
       button, added client-side so the rendered HTML stays plain. */
    document.querySelectorAll(".prose pre").forEach((pre, index) => {
      if (pre.closest(".code-copy-frame")) return;

      const code = pre.querySelector("code");
      const frame = document.createElement("div");
      const button = document.createElement("button");
      const liveRegion = document.createElement("span");
      const labelId = `code-copy-${index}`;

      frame.className = "code-copy-frame";
      button.type = "button";
      button.className = "code-copy-button";
      button.setAttribute("aria-describedby", labelId);
      button.textContent = "Copy";
      liveRegion.id = labelId;
      liveRegion.className = "sr-only";
      liveRegion.setAttribute("aria-live", "polite");

      pre.parentNode?.insertBefore(frame, pre);
      frame.append(pre, button, liveRegion);

      button.addEventListener("click", async () => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error("Clipboard API unavailable");
          await navigator.clipboard.writeText(code?.textContent ?? pre.textContent ?? "");
          button.textContent = "Copied";
          liveRegion.textContent = "Code copied";
        } catch {
          button.textContent = "Failed";
          liveRegion.textContent = "Copy failed";
        }
        window.setTimeout(() => {
          button.textContent = "Copy";
        }, 1800);
      });
    });
  </script>

  <script is:inline>
    const tocLinks = Array.from(document.querySelectorAll("[data-toc-link]"));

    if (tocLinks.length > 0) {
      const sections = tocLinks
        .map((link) => ({
          link,
          section: document.getElementById(decodeURIComponent(link.hash.slice(1))),
        }))
        .filter((item) => item.section);

      const updateCurrentSection = () => {
        let current = sections[0];

        for (const item of sections) {
          if (item.section.getBoundingClientRect().top <= window.innerHeight * 0.8) current = item;
          else break;
        }

        for (const item of sections) {
          if (item === current) item.link.setAttribute("aria-current", "location");
          else item.link.removeAttribute("aria-current");
        }
      };

      let updateScheduled = false;
      window.addEventListener("scroll", () => {
        if (updateScheduled) return;
        updateScheduled = true;
        window.requestAnimationFrame(() => {
          updateScheduled = false;
          updateCurrentSection();
        });
      }, { passive: true });
      window.addEventListener("resize", updateCurrentSection);
      updateCurrentSection();
    }
  </script>

  <style>
    .article-has-toc {
      --article-body-width: 49rem;
      --article-toc-width: 11rem;
      --article-column-gap: 5rem;
    }

    .article-has-toc .article-header {
      max-width: calc(var(--article-body-width) + var(--article-toc-width) + var(--article-column-gap));
    }

    .article-header .article-title {
      text-wrap: wrap;
    }

    .article-reading-layout {
      display: grid;
      grid-template-columns: minmax(0, var(--layout-content));
      grid-template-areas:
        "content"
        "navigation";
      justify-content: center;
      align-items: start;
    }

    .article-reading-layout--with-toc {
      width: 100%;
      max-width: calc(var(--article-body-width) + var(--article-toc-width) + var(--article-column-gap));
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "content"
        "navigation";
    }

    .article-content-layout {
      display: grid;
      grid-template-columns: minmax(0, var(--layout-content));
      grid-template-areas: "body";
      justify-content: center;
      align-items: start;
    }

    .article-content-layout--with-toc {
      grid-template-columns: minmax(0, var(--article-body-width)) minmax(0, var(--article-toc-width));
      grid-template-areas: "body toc";
      column-gap: var(--article-column-gap);
    }

    .article-toc {
      position: sticky;
      top: 5rem;
      grid-area: toc;
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
      margin-top: 3rem;
      border-left: 1px solid var(--border);
      padding-left: 1rem;
    }

    .article-image figcaption {
      margin-left: max(0px, min(5rem, calc((100% - 65rem) / 2)));
      margin-right: auto;
    }

    .article-toc h2 {
      margin: 0 0 0.75rem;
    }

    .article-toc ol {
      display: grid;
      gap: 0.4rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .article-toc a {
      display: block;
      border-left: 2px solid transparent;
      margin-left: -1.0625rem;
      padding: 0.1rem 0 0.1rem 0.9rem;
      color: var(--muted-foreground);
      font-size: 0.6875rem;
      line-height: 1.4;
      text-decoration: none;
      transition:
        border-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
    }

    .article-toc-item--nested a {
      padding-left: 1.5rem;
    }

    .article-toc a:hover,
    .article-toc a:focus-visible,
    .article-toc a[aria-current="location"] {
      border-left-color: var(--accent);
      color: var(--accent);
    }

    .article-body {
      grid-area: body;
    }

    .article-content-layout--with-toc .article-body {
      max-width: none;
      margin-inline: 0;
    }

    .article-navigation {
      grid-area: navigation;
    }

    .article-reading-layout--with-toc .article-navigation {
      max-width: var(--article-body-width);
      margin-inline: 0;
    }

    .article-has-toc + .article-related {
      --article-body-width: 49rem;
      --article-toc-width: 11rem;
      --article-column-gap: 5rem;
      max-width: var(--article-body-width);
      margin-left: max(0px, calc((100% - (var(--article-body-width) + var(--article-toc-width) + var(--article-column-gap))) / 2));
      margin-right: auto;
    }

    @media (max-width: 68rem) {
      .article-image figcaption {
        margin-left: max(0px, min(15rem, calc((100% - var(--layout-content)) / 2)));
      }

      .article-has-toc {
        --article-body-width: var(--layout-content);
        --article-toc-width: 10rem;
        --article-column-gap: 2rem;
      }

      .article-has-toc .article-header {
        max-width: var(--layout-content);
      }

      .article-reading-layout--with-toc {
        grid-template-columns: minmax(0, var(--layout-content));
        grid-template-areas:
          "content"
          "navigation";
      }

      .article-content-layout--with-toc {
        grid-template-columns: minmax(0, var(--layout-content));
        grid-template-areas:
          "toc"
          "body";
      }

      .article-toc {
        position: static;
        max-height: none;
        margin-top: 2rem;
      }

      .article-has-toc + .article-related {
        max-width: var(--layout-content);
        margin-inline: auto;
      }
    }

    @media (max-width: 48rem) {
      .article-toc {
        margin-inline: 0;
      }
    }
  </style>

</BaseLayout>
