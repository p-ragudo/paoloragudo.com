---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2 class="mb-0 pb-00">About Me</h2>
        <p class="mt-0 pt-0">
          I'm a software engineer that wants to improve their skills and document the journey. I write code every single day (except Sundays!)
          and try to get a little bit better than yesterday. I hope to be able to build a lot of projects and write a lot about my work and things
          that are interesting to me, and hope to share it with you!
        </p>

        <h2 class="mb-0 pb-00">Get in touch</h2>
        <p class="mt-0 pt-0">
          Questions, corrections, and requests are welcome through the <a href="/contact/">contact page</a>.
        </p>
        {
          siteConfig.email && (
            <p>You can also email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a> directly.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
